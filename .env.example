# Copia este archivo como .env y rellena tus valores reales
# .env esta en .gitignore y nunca se sube al repositorio

# ── Agente Web (agentev7.py) ─────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

GMAIL_USER=tu_correo@gmail.com
GMAIL_PASSWORD=tu_contraseña

TWITTER_USERNAME=@tu_usuario

# ── Agente Gamer (agentegamer3.py) ───────────────────────────────
DISCORD_GUILD_ID=tu_guild_id
DISCORD_CHANNEL_ID=tu_channel_id
DURACION_GAMER_S=3600

# ── Agente Admin (AgenteAdminDeRed.py) ───────────────────────────
# Requiere hosts.yaml con el inventario SSH (ver documentacion)
RUN_DURATION_S=3600

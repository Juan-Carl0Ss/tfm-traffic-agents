# ── PCAPs (archivos grandes de captura de red) ──────────────────
*.pcap
*.pcapng
*.cap

# ── Perfil persistente de Chrome (contiene sesiones y cookies) ──
chrome_profile_tfm/

# ── Drivers y ejecutables binarios ──────────────────────────────
chromedriver.exe
*.exe
*.lnk

# ── Instaladores / drivers de terceros ──────────────────────────
VBCABLE_Driver_Pack45/

# ── Archivos ZIP (exp1.zip ~2.1 GB, exp2.zip ~1.2 GB, drivers) ──
# Los experimentos se versionan como carpetas (sin los PCAP crudos),
# no como ZIP. Reproducibles con los scripts de exp1/ y exp2/.
*.zip

# ── Credenciales y variables de entorno ─────────────────────────
.env
.env.local

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── IDEs ────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Claude Code (contexto local de sesiones) ────────────────────
.claude/

# ── Capturas de pantalla de depuración (solo raíz del proyecto) ─
/*.png

# ── Datasets públicos de exp2 (775 MB; se rebajan con fetch_public.py) ──
# Se versiona solo procedencia.json: URLs y SHA-256 para poder reproducirlos.
exp2/public/*
!exp2/public/procedencia.json
